<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="sam_background">#070A14</color>
    <color name="ic_launcher_background">#070A14</color>

    <!-- Tema de janela (antes do Compose desenhar): fundo escuro para evitar flash branco. -->
    <style name="Theme.SamTv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sam_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
